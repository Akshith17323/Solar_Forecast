# All paths below are relative to the repository root.
APP_PROFILE_PATH=config/project.yaml
APP_ENV=development
APP_MAX_UPLOAD_BYTES=2097152
APP_MAX_RECORDS=10000
APP_MAX_FORECAST_POINTS=168
APP_MAX_ISSUES=100
APP_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# Used only by the optional Streamlit client.
BACKEND_URL=http://127.0.0.1:8000

# No provider is selected or enabled. Add real keys only to .env or a secret manager
# after implementing the chosen adapter. Never put keys in project YAML files.
